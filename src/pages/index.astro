---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import ProjectCover from '../components/ProjectCover.astro';
import { getSiteContent, projectStatus } from '../lib/data';
import { href, seriesHref } from '../lib/links';
const { notes, series } = await getSiteContent();
const featured = notes[0];
const projects = series.filter((item) => item.data.type === 'project' && item.data.status === 'in-progress');

---
<BaseLayout>
  <section class="hero container">
    <div class="hero-main"><span class="eyebrow">FIELD NOTES ON AX · VOL. 001</span><h1>일이 달라지는<br />순간을 <em>기록합니다.</em></h1><p class="hero-intro">악소리 나는 AX 경험담. AI와 Agent가 실제 일에 들어올 때 생기는 변화와 질문을 기록합니다.</p></div>
    <div class="hero-side"><div class="hero-code" aria-hidden="true">AX.</div><p>AI로 일하는 방식을 바꾸며 직접 써보고, 만들고, 실패하고, 생각한 것을 기록합니다.</p><a class="hero-scroll" href="#featured">기록과 실험 살펴보기 <span>↓</span></a></div>
  </section>
  <div class="home-spotlight container">
    <section class="home-featured" id="featured" aria-labelledby="featured-heading">
      <div class="section-header"><h2 id="featured-heading">Featured Note</h2></div>
      {featured ? <NoteCard note={featured} featured /> : <p>첫 번째 Note를 준비하고 있습니다.</p>}
    </section>
    <section class="home-projects" aria-labelledby="projects-heading">
      <div class="section-header"><h2 id="projects-heading">Projects</h2><a class="text-link" href={href('/projects/')}>모든 프로젝트 ↗</a></div>
      <div class:list={['home-project-grid', { 'single-project': projects.length === 1 }]}>
        {projects.length > 0 ? projects.map((project) => {
          if (project.data.type !== 'project') return null;
          const count = notes.filter((note) => note.data.collection === project.id).length;
          return <article class:list={['home-project', { 'has-cover': !!project.data.cover_image }]}>
            <a class="home-project-link" href={seriesHref(project.id)}>
              {project.data.cover_image && <div class="home-project-media"><ProjectCover src={project.data.cover_image} alt={project.data.cover_alt ?? `${project.data.title} 대표 이미지`} /></div>}
              <div class="home-project-copy"><p class="project-state">{projectStatus[project.data.status]} · {count}{project.data.planned_notes ? ` / ${project.data.planned_notes}` : ''} Notes</p><h3>{project.data.title}</h3><p class="home-project-description">{project.data.description}</p><span class="text-link">만드는 과정 읽기 ↗</span></div>
            </a>
          </article>;
        }) : <p class="home-project-empty">다음 실험을 준비합니다. 진행 중인 프로젝트가 없습니다.</p>}
      </div>
    </section>
  </div>
  <section class="home-notes container" id="latest"><div class="section-header"><h2>Latest Notes</h2><a class="text-link" href={href('/notes/')}>모든 기록 ↗</a></div><div class="note-grid">{notes.slice(0, 4).map((note, index) => <NoteCard note={note} index={index} />)}</div></section>
  <section class="manifesto container"><div><span class="eyebrow">WHY WE WRITE</span><h2>써보고, 만들고,<br />경험을 기록합니다.</h2></div><div class="manifesto-copy"><p>생각 하나는 Note, 계속 궁금하면 Series, 직접 만들어보기 시작하면 Project, 다른 사람도 써볼 수 있게 만들면 Lab.</p><a href={href('/about/')}>AX Notes 소개 ↗</a></div></section>
</BaseLayout>
