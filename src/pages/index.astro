---
import BaseLayout from '../layouts/BaseLayout.astro';
import NoteCard from '../components/NoteCard.astro';
import { getSiteContent } from '../lib/data';
import { href } from '../lib/links';

const { notes } = await getSiteContent();
---

<BaseLayout>
  <section class="hero container">
    <div>
      <span class="eyebrow">FIELD NOTES ON AX · VOL. 001</span>
      <h1>일이 달라지는<br />순간을 <em>기록합니다.</em></h1>
    </div>
    <div class="hero-side">
      <div class="hero-code" aria-hidden="true">✳</div>
      <p>도구를 써 보고, 작은 것을 만들고, 생각이 바뀐 순간을 적습니다. AX를 거창한 구호보다 구체적인 경험으로 남기는 노트.</p>
      <a class="hero-scroll" href="#latest">최근 글 보기 <span>↓</span></a>
    </div>
  </section>

  <section class="home-notes container" id="latest" aria-labelledby="latest-title">
    <div class="section-header"><h2 id="latest-title">최근 기록</h2><a class="text-link" href={href('/notes/')}>모든 글 보기 ↗</a></div>
    <div class="note-grid">{notes.slice(0, 4).map((note, index) => <NoteCard note={note} index={index} />)}</div>
  </section>

  <section class="manifesto container">
    <div><span class="eyebrow">WHY WE WRITE</span><h2>변화는<br />작은 기록에서<br />시작됩니다.</h2></div>
    <div class="manifesto-copy"><p>AI와 Agent가 일하는 방식을 바꾸는 동안, 실제로 무엇이 달라졌는지 남깁니다. 잘된 실험뿐 아니라 막혔던 지점과 다음 질문까지요.</p><a href={href('/about/')}>AX Notes 소개 읽기 ↗</a></div>
  </section>
</BaseLayout>
