---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { contextFields } from '../../lib/context-builder';
---
<BaseLayout title="Context Builder" description="여섯 가지 질문으로 AI를 위한 내 업무 Context 문서를 만듭니다">
  <div class="page-heading container"><span class="eyebrow">LAB / CONTEXT BUILDER</span><h1>먼저, 내 업무부터.</h1><p>AI가 알아야 할 나의 역할과 일하는 기준을 정리합니다.</p></div>
  <div class="page-content container">
    <p class="lab-privacy">입력 내용은 브라우저에서만 처리하며 서버로 전송하지 않습니다. 자동 저장하지 않으므로 페이지를 닫기 전에 결과를 가져가세요.</p>
    <div class="lab-layout">
      <form id="context-form">{contextFields.map(({ key, label, hint }) => <div class="lab-field"><label for={key}>{label}</label><textarea id={key} name={key} rows="3" maxlength="10000" placeholder={hint}></textarea></div>)}<button class="lab-button" type="submit">Context 문서 만들기 →</button></form>
      <section class="lab-result" aria-labelledby="result-title"><span class="eyebrow">YOUR CONTEXT / MARKDOWN</span><h2 id="result-title">내 업무 Context</h2><label class="sr-only" for="context-result">생성된 Markdown 문서</label><textarea id="context-result" rows="24" readonly placeholder="질문에 답하면 이곳에 Markdown 문서가 만들어집니다."></textarea><div class="lab-actions"><button class="lab-button" type="button" id="copy-context" disabled>복사</button><button class="lab-button" type="button" id="download-context" disabled>.md 다운로드</button></div><p id="context-status" role="status" aria-live="polite"></p></section>
    </div>
  </div>
  <script>
    import { buildContext, contextFields, type ContextInput } from '../../lib/context-builder';
    const form = document.querySelector<HTMLFormElement>('#context-form')!;
    const result = document.querySelector<HTMLTextAreaElement>('#context-result')!;
    const status = document.querySelector<HTMLElement>('#context-status')!;
    const copy = document.querySelector<HTMLButtonElement>('#copy-context')!;
    const download = document.querySelector<HTMLButtonElement>('#download-context')!;
    form.addEventListener('input', () => {
      result.value = '';
      copy.disabled = download.disabled = true;
      status.textContent = '입력을 수정했습니다. 문서를 다시 만들어주세요.';
    });
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const input: ContextInput = {};
      for (const { key } of contextFields) input[key] = String(data.get(key) ?? '');
      result.value = buildContext(input);
      copy.disabled = download.disabled = !result.value;
      status.textContent = result.value ? 'Context 문서를 만들었습니다. 비어 있는 항목을 확인하고 가져가세요.' : '한 가지 이상 입력해주세요.';
    });
    copy.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(result.value); status.textContent = '복사했습니다.'; }
      catch { result.focus(); result.select(); status.textContent = '자동 복사를 사용할 수 없습니다. 선택된 문서를 직접 복사해주세요.'; }
    });
    download.addEventListener('click', () => {
      const url = URL.createObjectURL(new Blob([result.value], { type: 'text/markdown;charset=utf-8' }));
      const link = document.createElement('a');
      link.href = url; link.download = 'my-work-context.md'; document.body.append(link); link.click(); link.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
      status.textContent = 'Markdown 파일 다운로드를 시작했습니다.';
    });
  </script>
</BaseLayout>
