---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteRow from '../../components/NoteRow.astro';
import { getSiteContent } from '../../lib/data';
import { tagHref } from '../../lib/links';
const { notes, tags } = await getSiteContent();
---
<BaseLayout title="Notes" description="AI로 일하는 방식을 바꾸며 배우고 생각한 모든 Note">
  <div class="page-heading container"><span class="eyebrow">NOTES / {String(notes.length).padStart(2, '0')}</span><h1>모든 기록</h1><p>생각, 경험, 실패, 그리고 다음 질문. 모든 글은 Note입니다.</p></div>
  <div class="page-content container">
    <div class="filter-row" aria-label="주제로 찾아보기">{tags.map((tag) => <a class="text-link" href={tagHref(tag.slug)}>#{tag.label} ({tag.count})</a>)}</div>
    <div class="list-rows">{notes.map((note) => <NoteRow note={note} />)}</div>
  </div>
</BaseLayout>
