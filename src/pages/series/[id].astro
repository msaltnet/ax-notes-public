---
import BaseLayout from '../../layouts/BaseLayout.astro';
import NoteRow from '../../components/NoteRow.astro';
import { getSiteContent, type Note, type Series } from '../../lib/data';

interface Props { series: Series; notes: Note[] }
export async function getStaticPaths() {
  const { notes, series } = await getSiteContent();
  return series.map((item) => ({ params: { id: item.id }, props: { series: item, notes: notes.filter((note) => note.data.series === item.id).sort((a, b) => (a.data.series_order ?? 0) - (b.data.series_order ?? 0)) } }));
}
const { series, notes } = Astro.props;
---

<BaseLayout title={series.data.title} description={series.data.description}>
  <div class="page-heading container"><span class="eyebrow">SERIES / {String(notes.length).padStart(2, '0')} NOTES</span><h1>{series.data.title}</h1><p>{series.data.description}</p></div>
  <div class="page-content container"><div class="list-rows">{notes.map((note) => <NoteRow note={note} />)}</div></div>
</BaseLayout>
