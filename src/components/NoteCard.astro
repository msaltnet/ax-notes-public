---
import type { Note } from '../lib/data';
import { noteHref } from '../lib/links';

interface Props { note: Note; index?: number; featured?: boolean }
const { note, index, featured = false } = Astro.props;
const typeName = { story: 'STORY', tip: 'TIP', take: 'TAKE' }[note.data.type];
const date = new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(`${note.data.date}T00:00:00`));
---

<article class:list={['note-card', { featured }]}>
  <a href={noteHref(note.id)} class="note-card-link" aria-label={`${note.data.title} 읽기`}>
    <div class="card-topline">
      <span class="card-index">{String((index ?? 0) + 1).padStart(2, '0')}</span>
      <span class="type-label">{typeName}</span>
      <span class="card-date">{date}</span>
    </div>
    <div class="card-body">
      <h3>{note.data.title}</h3>
      <p>{note.data.description}</p>
    </div>
    <div class="card-bottomline">
      <span class="card-tags">{note.data.tags.slice(0, 2).join(' · ')}</span>
      <span class="card-arrow" aria-hidden="true">↗</span>
    </div>
  </a>
</article>
