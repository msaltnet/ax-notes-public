---
import type { Note } from '../lib/data';
import { noteHref } from '../lib/links';

interface Props { note: Note }
const { note } = Astro.props;
---

<a class="list-row" href={noteHref(note.id)}>
  <div><h2>{note.data.title}</h2><p>{note.data.description}</p></div>
  <time class="row-date" datetime={note.data.date}>{note.data.date}</time>
  <span class="row-arrow" aria-hidden="true">↗</span>
</a>
